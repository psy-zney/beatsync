# Copy to .env.worker on the local machine. This process does not accept user
# traffic; it opens one outbound WebSocket to the public VPS hostname.
WORKER_SERVER_URL=https://backend.example.com
HYBRID_WORKER_SECRET=
WORKER_ID=local-primary
WORKER_CONCURRENCY=2

# Optional second authentication layer when /internal/worker is protected by
# a Cloudflare Access service-token policy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Optional Spotify API credentials. Public metadata remains the fallback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Local extraction tools. Use absolute paths on Windows when they are not in
# PATH or not placed next to a pre-built beatsync-server.exe.
# YT_EXTRACTOR_PATH=C:\tools\beatsync\yt-rust-extractor.exe
# YTDLP_PATH=C:\tools\beatsync\yt-dlp.exe
YOUTUBE_COOKIES_PATH=../../cookies.txt
UPSTREAM_TIMEOUT=20s
EXTRACTOR_TIMEOUT=45s

# Worker RAM is independent from the VPS limits.
MEMORY_SOFT_LIMIT_MB=1024
MEMORY_HARD_LIMIT_MB=1536
