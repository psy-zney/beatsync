HOST=127.0.0.1
PORT=1001
CREATOR_SECRET=
PROVIDER_URL=

# Spotify credentials are optional. Without them the server uses public embed/oEmbed metadata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

S3_BUCKET_NAME=beatsync-bucket
S3_PUBLIC_URL=https://storage.example.com
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Defaults for a 1 GB VPS. Keep soft < hard < systemd MemoryMax (420 MiB).
STREAM_MAX_CONCURRENCY=1
STREAM_MAX_QUEUE=12
MAX_AUDIO_DOWNLOAD_MB=120
MEMORY_SOFT_LIMIT_MB=220
MEMORY_HARD_LIMIT_MB=320
MEMORY_CHECK_INTERVAL=5s
ROOM_IDLE_TTL=2m
BACKUP_INTERVAL=2m
LOCAL_BACKUP_PATH=./data/state-backup-latest.json

# The release installer places all three binaries beside each other, so these
# are normally unnecessary in production.
# YT_EXTRACTOR_PATH=/opt/beatsync/current/yt-rust-extractor
# YTDLP_PATH=/opt/beatsync/current/yt-dlp
YOUTUBE_COOKIES_PATH=../../cookies.txt
EXTRACTOR_TIMEOUT=30s

DEMO=0
DEMO_ROOM_ID=000000
DEMO_AUDIO_DIR=./demo-audio
