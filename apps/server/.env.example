HOST=0.0.0.0
PORT=1001
PROVIDER_URL=
CREATOR_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
DEMO=0
DEMO_AUDIO_DIR=./demo-audio
DEMO_ADMIN_SECRET=beatsync
S3_BUCKET_NAME=beatsync-bucket
S3_PUBLIC_URL=http://DUCKDNS_DOMAIN:9000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password123

# Small-VPS resilience (defaults shown; PM2 also supplies these in production)
STREAM_MAX_CONCURRENCY=1
STREAM_MAX_QUEUE=20
MAX_AUDIO_DOWNLOAD_MB=120
MEMORY_SOFT_LIMIT_MB=600
MEMORY_HARD_LIMIT_MB=750
MEMORY_CHECK_INTERVAL_MS=5000
RESTORE_ROOM_CONCURRENCY=4
RESTORE_OBJECT_CONCURRENCY=8
# Relative to apps/server when started by PM2
LOCAL_BACKUP_PATH=./data/state-backup-latest.json

# LiveKit
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
