{
  "name": "beatsync",
  "packageManager": "bun@1.3.8",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "server": "bun run --cwd apps/server dev",
    "client": "turbo start --filter=client",
    "docker:build": "docker build --tag beatsync-server:local .",
    "docker:up": "docker compose up --build --detach",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow server",
    "docker:ps": "docker compose ps",
    "demo:dev": "turbo run dev:demo",
    "demo:build": "turbo run build:demo",
    "demo": "turbo run demo",
    "demo:log": "turbo run demo:log",
    "dev:log": "turbo run dev:log",
    "start:log": "turbo run start:log",
    "prepare": "lefthook install"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.2",
    "prettier": "^3.8.1",
    "tslib": "^2.8.1",
    "turbo": "^2.9.16"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
